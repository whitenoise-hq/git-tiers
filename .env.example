# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 커밋되지 않음)
#   cp .env.example .env.local

# ─── NextAuth ─────────────────────────────────────────────
# 서비스 주소. 배지 응답의 CORS 허용 Origin 으로도 쓰인다.
NEXTAUTH_URL=http://localhost:3000
# 세션 JWT 암호화 키. 생성: openssl rand -base64 32
NEXTAUTH_SECRET=

# ─── GitHub OAuth App ─────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Firebase Admin SDK (서버 전용) ────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성 (JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSON 의 private_key 값을 큰따옴표로 감싸 한 줄로 넣는다(줄바꿈은 \n 그대로).
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── GitHub API 서버 토큰 (필수) ──────────────────────────
# 배지·마이페이지의 기여 수를 서버가 조회할 때 쓴다(사용자 토큰과 무관하게 자동 갱신).
# 권한(scope) 없는 개인 토큰이면 충분: GitHub → Settings → Developer settings → Personal access tokens
# yarn migrate:user-keys 스크립트도 이 토큰을 쓴다.
GITHUB_TOKEN=

# ─── 예약 작업(GitHub Actions) ────────────────────────────
# 매일 기여 수를 새로 조회하는 /api/cron/refresh-contributions 보호용. 생성: openssl rand -base64 32
# 같은 값을 GitHub 레포 Secrets 의 CRON_SECRET 에도 넣는다(워크플로가 Authorization: Bearer 헤더로 붙여 호출).
CRON_SECRET=
